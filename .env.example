# Copy to .env (gitignored) and pass it at build time:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
# Base URL of the backend; the app appends /api/... itself.
API_BASE_URL=https://pos.chita.co.tz
# Business Admin web app (billing / subscription and password-reset links).
BUSINESS_ADMIN_URL=https://pos.chita.co.tz/app
